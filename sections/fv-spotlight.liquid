{{ 'furneview.css' | asset_url | stylesheet_tag }}
{%- assign p = section.settings.product -%}
{%- if p != blank -%}
<section class="fv fvsp">
  <div class="page-width">
    <h2 class="fv-cap-h">{{ section.settings.heading }}</h2>
    <div class="fvsp__in">
      <a class="fvsp__media" href="{{ p.url }}">
        {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 990px) 50vw, 100vw' }}{%- endif -%}
      </a>
      <div class="fvsp__copy">
        <h3 class="fvsp__t">{{ p.title | split: ' – ' | first | split: ' Sheesham' | first }}</h3>
        {%- if section.settings.subtitle != blank -%}<p class="fvsp__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
        <p class="fvsp__d">{{ p.description | strip_html | truncatewords: 34 }}</p>
        <p class="fvsp__price">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</p>
        <a class="fv-gold-btn fv-gold-btn--line" href="{{ p.url }}">{{ section.settings.button }}</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Furneview product spotlight",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the spotlight" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "subtitle", "label": "Italic line", "default": "The honey finish edition" },
    { "type": "text", "id": "button", "label": "Button", "default": "View details" }
  ],
  "presets": [{ "name": "Furneview product spotlight" }]
}
{% endschema %}
