{{ 'furneview.css' | asset_url | stylesheet_tag }}
<style>
  .fv-poster{display:grid;grid-template-columns:minmax(0,520px) minmax(0,1fr);gap:28px;align-items:center}
  .fv-pslider{position:relative;isolation:isolate}
  .fv-pslides{position:relative;aspect-ratio:3/4;max-width:100%;border-radius:22px;overflow:hidden;box-shadow:0 18px 40px rgba(30,26,23,.14);background:var(--fv-panel);touch-action:pan-y}
  .fv-pslide{position:absolute;inset:0;display:block;opacity:0;visibility:hidden;transition:opacity .5s}
  .fv-pslide.is-on{opacity:1;visibility:visible}
  .fv-pslide img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
  .fv-pslide img.fv-pbg{object-fit:cover;filter:blur(22px) brightness(.95);transform:scale(1.15)}
  .fv-pdots{display:flex;gap:8px;justify-content:center;margin-top:12px}
  .fv-pdots button{width:26px;height:5px;border:0;border-radius:5px;background:var(--fv-line);padding:0;cursor:pointer}
  .fv-pdots button.is-on{background:var(--fv-orange)}
  .fv-pnav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:99px;border:0;background:rgba(255,255,255,.85);color:var(--fv-ink);font-size:2rem;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.15);z-index:1}
  .fv-pnav--prev{left:10px}.fv-pnav--next{right:10px}
  .fv-poster__side{display:flex;flex-direction:column;gap:14px}
  .fv-poster__side h2{font-size:clamp(3rem,4vw,4.6rem);line-height:1.08;color:#1F6B3B}
  .fv-poster__side p{color:var(--fv-muted);font-size:1.6rem;max-width:42ch}
  .fv-poster__btns{display:flex;gap:10px;flex-wrap:wrap}
  .fv-poster__btns .fv-btn{border-radius:99px;padding:14px 24px}
  .fv-poster__addr{background:var(--fv-card);border:1px solid var(--fv-line);border-radius:16px;padding:14px 16px;font-size:1.5rem}
  @media (max-width:860px){.fv-poster{grid-template-columns:1fr}.fv-poster__side{display:none}.fv-pslides{border-radius:16px}}
</style>
<section class="fv" style="padding-block:16px 8px">
  <div class="page-width fv-poster">
    <div class="fv-pslider" id="fv-ps-{{ section.id }}">
      <div class="fv-pslides" style="aspect-ratio:{{ section.settings.ratio }}">
        {%- for block in section.blocks -%}
          <a class="fv-pslide{% if forloop.first %} is-on{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: class: 'fv-pbg', alt: '', loading: 'lazy' }}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', sizes: '(min-width: 860px) 520px, 100vw', alt: block.settings.alt }}
            {%- elsif block.settings.builtin != blank -%}
              {%- assign big = block.settings.builtin | append: '.jpg' -%}{%- assign small = block.settings.builtin | append: '-sm.jpg' -%}
              <img class="fv-pbg" src="{{ small | asset_url }}" alt="" loading="lazy"><img src="{{ big | asset_url }}" srcset="{{ small | asset_url }} 600w, {{ big | asset_url }} 1200w" sizes="(min-width: 860px) 520px, 100vw" alt="{{ block.settings.alt | escape }}"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button class="fv-pnav fv-pnav--prev" type="button" data-d="-1" aria-label="Previous poster">‹</button>
        <button class="fv-pnav fv-pnav--next" type="button" data-d="1" aria-label="Next poster">›</button>
        <div class="fv-pdots">{%- for block in section.blocks -%}<button type="button" data-i="{{ forloop.index0 }}" aria-label="Poster {{ forloop.index }}"{% if forloop.first %} class="is-on"{% endif %}></button>{%- endfor -%}</div>
      {%- endif -%}
    </div>
    <div class="fv-poster__side">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.address != blank -%}<div class="fv-poster__addr">📍 {{ section.settings.address }}</div>{%- endif -%}
      <div class="fv-poster__btns">
        <a class="fv-btn fv-btn--orange" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button }} →</a>
        {%- if section.settings.map_link != blank -%}<a class="fv-btn fv-btn--outline" href="{{ section.settings.map_link }}" target="_blank" rel="noopener">Get directions</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var r=document.getElementById('fv-ps-{{ section.id }}'); if(!r) return;
  var s=r.querySelectorAll('.fv-pslide'), d=r.querySelectorAll('.fv-pdots button'), i=0, t, x0=null;
  if(s.length<2) return;
  function go(k){i=(k+s.length)%s.length;s.forEach(function(e,j){e.classList.toggle('is-on',j===i)});d.forEach(function(e,j){e.classList.toggle('is-on',j===i)})}
  function auto(){clearInterval(t);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)t=setInterval(function(){go(i+1)},{{ section.settings.speed | times: 1000 }})}
  r.addEventListener('click',function(e){var b=e.target.closest('[data-d]'),n=e.target.closest('[data-i]');if(b){go(i+ +b.dataset.d);auto()}if(n){go(+n.dataset.i);auto()}});
  var box=r.querySelector('.fv-pslides');
  box.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
  box.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;if(Math.abs(dx)>40){go(i+(dx<0?1:-1));auto()}x0=null});
  auto();
})();
</script>
{% schema %}
{
  "name": "Furneview poster slider",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "ratio", "label": "Frame shape", "default": "3/4", "options": [{"value":"3/4","label":"Tall (3:4)"},{"value":"4/5","label":"Portrait (4:5)"},{"value":"1/1","label":"Square"}] },
    { "type": "range", "id": "speed", "label": "Seconds per poster", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "text", "id": "eyebrow", "label": "Small label (desktop)", "default": "Grand opening" },
    { "type": "text", "id": "heading", "label": "Heading (desktop)", "default": "Visit our new store" },
    { "type": "text", "id": "text", "label": "Text (desktop)", "default": "Flat 10% off. Customise design, size and material at no extra charge, in sheesham and teak wood." },
    { "type": "text", "id": "address", "label": "Store address", "info": "Leave empty to hide." },
    { "type": "url", "id": "map_link", "label": "Google Maps link" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" }
  ],
  "max_blocks": 8,
  "blocks": [{ "type": "poster", "name": "Poster", "settings": [
    { "type": "image_picker", "id": "image", "label": "Poster image" },
    { "type": "select", "id": "builtin", "label": "Built-in poster (used if no image)", "default": "", "options": [
      {"value":"","label":"None"},{"value":"fv-grand-opening","label":"Grand Opening"},{"value":"fv-deepavali","label":"Deepavali greetings"}]},
    { "type": "text", "id": "alt", "label": "Image description", "default": "Furneview poster" },
    { "type": "url", "id": "link", "label": "Poster link" }
  ]}],
  "presets": [{ "name": "Furneview poster slider", "blocks": [
    { "type": "poster", "settings": { "builtin": "fv-grand-opening", "alt": "Furneview Grand Opening: flat 10% off, design it your way" } },
    { "type": "poster", "settings": { "builtin": "fv-deepavali", "alt": "Deepavali greetings from Furneview" } }
  ]}]
}
{% endschema %}
