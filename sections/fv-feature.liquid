{{ 'furneview.css' | asset_url | stylesheet_tag }}
{%- assign fp = section.settings.product -%}
{%- if fp != blank -%}
<section class="fv fvsp">
  <div class="page-width">
    <h2 class="fv-cap-h">{{ section.settings.heading }}</h2>
    <div class="fvsp__in">
      <a class="fvsp__media" href="{{ fp.url }}">
        {%- if fp.featured_image != blank -%}
          <img src="{{ fp.featured_image | image_url: width: 1200 }}" alt="{{ fp.title | escape }}" loading="lazy" width="1200" height="900">
        {%- endif -%}
      </a>
      <div class="fvsp__copy">
        <h3 class="fvsp__t">{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ fp.title }}{% endif %}</h3>
        {%- if section.settings.subtitle != blank -%}<p class="fvsp__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
        <p class="fvsp__d">{{ fp.description | strip_html | truncatewords: 34 }}</p>
        <p class="fvsp__price">{{ fp.price | money }}{% if fp.compare_at_price > fp.price %} <s>{{ fp.compare_at_price | money }}</s>{% endif %}</p>
        <a class="fv-gold-btn fv-gold-btn--line" href="{{ fp.url }}">{{ section.settings.button }}</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Furneview spotlight",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the spotlight" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "title", "label": "Short name (optional)" },
    { "type": "text", "id": "subtitle", "label": "Italic line", "default": "The honey finish edition" },
    { "type": "text", "id": "button", "label": "Button", "default": "View details" }
  ],
  "presets": [{ "name": "Furneview spotlight" }]
}
{% endschema %}
