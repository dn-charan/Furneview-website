{{ 'furneview.css' | asset_url | stylesheet_tag }}
{%- assign btn_url = section.settings.button_link | default: '/collections/all' -%}
<section class="fv fvh fvh--{{ section.settings.style }}">
  <div class="fvh__in">
    <div class="fvh__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt, sizes: '(min-width: 990px) 62vw, 100vw', class: 'fvh__img' }}
      {%- else -%}
        <img class="fvh__img" src="{{ 'fv-window-sofa.jpg' | asset_url }}" srcset="{{ 'fv-window-sofa-sm.jpg' | asset_url }} 900w, {{ 'fv-window-sofa.jpg' | asset_url }} 1672w" sizes="(min-width: 990px) 62vw, 100vw" width="1672" height="941" alt="{{ section.settings.image_alt | escape }}" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="fvh__copy">
      {%- if section.settings.kicker != blank -%}<p class="fvh__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 class="fvh__h">{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.text != blank -%}<p class="fvh__p">{{ section.settings.text }}</p>{%- endif -%}
      <div class="fvh__ctas">
        <a class="fvh__btn" href="{{ btn_url }}">{{ section.settings.button_label }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- if section.settings.button2_label != blank -%}
          <a class="fvh__link" href="{{ section.settings.button2_link | default: '/pages/visit' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Furneview top banner",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "style", "label": "Layout", "default": "split", "options": [{ "value": "split", "label": "Photo beside text" }, { "value": "overlay", "label": "Text on a dark photo" }] },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "A wide room photo. Leave empty to use the sage sofa photo." },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Sage green fabric sofa set in a bright living room" },
    { "type": "text", "id": "kicker", "label": "Small line above heading", "default": "Modern designs. Timeless comfort." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Furniture that defines your space" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sofas, beds and dining sets made to your size and fabric, with free delivery and installation in Bengaluru." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to open all products." },
    { "type": "text", "id": "button2_label", "label": "Second link label", "default": "Visit a store" },
    { "type": "url", "id": "button2_link", "label": "Second link", "info": "Leave empty to open the store visit page." }
  ],
  "presets": [{ "name": "Furneview top banner" }]
}
{% endschema %}
