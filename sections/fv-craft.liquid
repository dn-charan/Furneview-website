{{ 'furneview.css' | asset_url | stylesheet_tag }}
<section class="fv fvc">
  <div class="fvc__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '', sizes: '100vw' }}
    {%- endif -%}
  </div>
  <div class="page-width fvc__in">
    <p class="fvc__k">{{ section.settings.kicker }}</p>
    <h2 class="fvc__h">{{ section.settings.heading | newline_to_br }}</h2>
    <span class="fvc__rule" aria-hidden="true"></span>
    {%- if section.settings.text != blank -%}<p class="fvc__p">{{ section.settings.text }}</p>{%- endif -%}
    <ul class="fvc__list">
      {%- for i in (1..3) -%}{%- assign k = 'point' | append: i -%}{%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}{%- endfor -%}
    </ul>
    <div class="fvc__ctas"><a class="fv-gold-btn" href="{{ section.settings.link | default: '/collections/dining' }}">{{ section.settings.button }}</a><a class="fvc__link" href="/pages/wood-guide">Wood &amp; care guide</a></div>
  </div>
</section>
{%- assign fp = all_products[section.settings.spot_handle] -%}
{%- if section.settings.show_spot and fp != blank and fp.id -%}
<section class="fv fvsp">
  <div class="page-width">
    <h2 class="fv-cap-h">{{ section.settings.spot_heading }}</h2>
    <div class="fvsp__in">
      <a class="fvsp__media" href="{{ fp.url }}">{%- if fp.featured_image != blank -%}<img src="{{ fp.featured_image | image_url: width: 1200 }}" alt="{{ fp.title | escape }}" loading="lazy" width="1200" height="900">{%- endif -%}</a>
      <div class="fvsp__copy">
        <h3 class="fvsp__t">{% if section.settings.spot_title != blank %}{{ section.settings.spot_title }}{% else %}{{ fp.title }}{% endif %}</h3>
        {%- if section.settings.spot_sub != blank -%}<p class="fvsp__sub">{{ section.settings.spot_sub }}</p>{%- endif -%}
        <p class="fvsp__d">{{ fp.description | strip_html | truncatewords: 34 }}</p>
        <p class="fvsp__price">{{ fp.price | money }}{% if fp.compare_at_price > fp.price %} <s>{{ fp.compare_at_price | money }}</s> <em class="fv-save">Save {{ fp.compare_at_price | minus: fp.price | money_without_trailing_zeros }}</em>{% endif %}</p>
        <a class="fv-gold-btn fv-gold-btn--line" href="{{ fp.url }}">View details</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Furneview craft banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Wood or carving photo" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "The Furneview craft" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Hand-carved details,\nsolid wood that lasts" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every dining set is built in solid sheesham with carved and cane details, finished in warm honey and walnut tones." },
    { "type": "text", "id": "point1", "label": "Point 1", "default": "Solid sheesham wood" },
    { "type": "text", "id": "point2", "label": "Point 2", "default": "Carved and cane details" },
    { "type": "text", "id": "point3", "label": "Point 3", "default": "Honey and walnut finishes" },
    { "type": "text", "id": "button", "label": "Button", "default": "Explore dining sets" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "header", "content": "Spotlight below" },
    { "type": "checkbox", "id": "show_spot", "label": "Show a product spotlight below", "default": true },
    { "type": "text", "id": "spot_heading", "label": "Spotlight heading", "default": "In the spotlight" },
    { "type": "text", "id": "spot_handle", "label": "Product handle", "default": "ramugili-sheesham-wood-6-seater-dining-set-in-honey-finish", "info": "The last part of the product's web address." },
    { "type": "text", "id": "spot_title", "label": "Short name", "default": "Ramugili" },
    { "type": "text", "id": "spot_sub", "label": "Italic line", "default": "The honey finish edition" }
  ],
  "presets": [{ "name": "Furneview craft banner" }]
}
{% endschema %}
