{{ 'furneview.css' | asset_url | stylesheet_tag }}
<section class="fv fvc">
  <div class="fvc__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '', sizes: '100vw' }}
    {%- endif -%}
  </div>
  <div class="page-width fvc__in">
    <p class="fvc__k">{{ section.settings.kicker }}</p>
    <h2 class="fvc__h">{{ section.settings.heading | newline_to_br }}</h2>
    <span class="fvc__rule" aria-hidden="true"></span>
    {%- if section.settings.text != blank -%}<p class="fvc__p">{{ section.settings.text }}</p>{%- endif -%}
    <ul class="fvc__list">
      {%- for i in (1..3) -%}{%- assign k = 'point' | append: i -%}{%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}{%- endfor -%}
    </ul>
    <a class="fv-gold-btn" href="{{ section.settings.link | default: '/collections/dining' }}">{{ section.settings.button }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Furneview craft banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Wood or carving photo" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "The Furneview craft" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Hand-carved details,\nsolid wood that lasts" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every dining set is built in solid sheesham with carved and cane details, finished in warm honey and walnut tones." },
    { "type": "text", "id": "point1", "label": "Point 1", "default": "Solid sheesham wood" },
    { "type": "text", "id": "point2", "label": "Point 2", "default": "Carved and cane details" },
    { "type": "text", "id": "point3", "label": "Point 3", "default": "Honey and walnut finishes" },
    { "type": "text", "id": "button", "label": "Button", "default": "Explore dining sets" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Furneview craft banner" }]
}
{% endschema %}
