{{ 'furneview.css' | asset_url | stylesheet_tag }}
<section class="fv">
  <div class="page-width">
    <div class="fv-head"><div><span class="fv-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="fv-rooms">
      {%- for block in section.blocks -%}
        <a class="fv-room" href="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" style="background:{{ block.settings.bg }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy' }}{%- else -%}{% render 'fv-art', name: block.settings.icon %}{%- endif -%}
          <span>{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Furneview rooms",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Get the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by room" }
  ],
  "max_blocks": 8,
  "blocks": [{ "type": "room", "name": "Room", "settings": [
    { "type": "text", "id": "title", "label": "Name", "default": "Living room" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Room photo (recommended)" },
    { "type": "color", "id": "bg", "label": "Background colour", "default": "#F6E3D3" },
    { "type": "select", "id": "icon", "label": "Illustration (if no photo)", "default": "sofa", "options": [
      {"value":"sofa","label":"Sofa"},{"value":"bed","label":"Bed"},{"value":"dining","label":"Dining"},{"value":"study","label":"Study"}]}
  ]}],
  "presets": [{ "name": "Furneview rooms", "blocks": [
    {"type":"room","settings":{"title":"Living room","icon":"sofa","bg":"#F6E3D3"}},
    {"type":"room","settings":{"title":"Bedroom","icon":"bed","bg":"#E3EEE6"}},
    {"type":"room","settings":{"title":"Dining","icon":"dining","bg":"#F3ECDF"}},
    {"type":"room","settings":{"title":"Home office","icon":"study","bg":"#E8E6E3"}}
  ]}]
}
{% endschema %}
