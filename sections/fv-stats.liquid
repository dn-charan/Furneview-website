{{ 'furneview.css' | asset_url | stylesheet_tag }}
<section class="fv" style="padding-block:20px">
  {%- liquid
  assign has_band = false
  if section.settings.stat1_number != blank or section.settings.stat2_number != blank or section.settings.seal_top != blank
    assign has_band = true
  endif
-%}
  <div class="page-width fv-stats2{% unless has_band %} fv-stats2--solo{% endunless %}">
    {%- if has_band -%}
    <div class="fv-stats2__band">
      {%- for i in (1..2) -%}
        {%- liquid
          assign kn = 'stat' | append: i | append: '_number'
          assign kl = 'stat' | append: i | append: '_label'
        -%}
        {%- if section.settings[kn] != blank -%}
          <div class="fv-stat2">
            <span class="fv-stat2__ic" aria-hidden="true">
              {%- if i == 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><circle cx="9" cy="10" r=".8" fill="currentColor"/><circle cx="15" cy="10" r=".8" fill="currentColor"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 11V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M3 13a2 2 0 0 1 4 0v2h10v-2a2 2 0 0 1 4 0v4H3z"/><path d="M5 17v2M19 17v2"/></svg>{%- endif -%}
            </span>
            <div><b>{{ section.settings[kn] }}</b><span>{{ section.settings[kl] }}</span></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.seal_top != blank -%}
        <div class="fv-seal"><div class="fv-seal__star">{{ section.settings.seal_top }}</div><span class="fv-seal__label">{{ section.settings.seal_bottom }}</span></div>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="fv-why2">
      {%- if section.settings.why_heading != blank -%}
        <div class="fv-why2__h"><i aria-hidden="true"></i><h2>{{ section.settings.why_heading }}</h2><i aria-hidden="true"></i></div>
      {%- endif -%}
      <div class="fv-why2__row">
      {%- for block in section.blocks -%}
        <div class="fv-why2__item" {{ block.shopify_attributes }}>
          <span class="fv-why2__ic" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 48 40"><path d="M2 12h8M0 18h7M3 24h6" stroke="#FFB48A" stroke-width="2.4" stroke-linecap="round"/><path d="M10 6h20a2 2 0 0 1 2 2v20H10z" fill="#F25A0B"/><path d="M32 13h7l6 7v8H32z" fill="#C9470A"/><path d="M35 15h4l4 5h-8z" fill="#FFE1CF"/><circle cx="17" cy="30" r="5" fill="#1E1A17"/><circle cx="17" cy="30" r="2" fill="#fff"/><circle cx="38" cy="30" r="5" fill="#1E1A17"/><circle cx="38" cy="30" r="2" fill="#fff"/></svg>
            {%- when 'install' -%}<svg viewBox="0 0 48 40"><path d="M14 4l20 26" stroke="#1F6B3B" stroke-width="5" stroke-linecap="round"/><path d="M30 25l6 8" stroke="#2E8A4E" stroke-width="8" stroke-linecap="round"/><path d="M36 6a6 6 0 0 0-7 8L13 30a3 3 0 1 0 4 4l16-16a6 6 0 0 0 8-7l-4 4-4-1-1-4z" fill="#F25A0B"/></svg>
            {%- when 'box' -%}<svg viewBox="0 0 48 40"><path d="M24 2 6 10v18l18 9 18-9V10z" fill="#F25A0B"/><path d="M6 10l18 9 18-9" fill="none" stroke="#FFE1CF" stroke-width="2"/><path d="M24 19v18" stroke="#C9470A" stroke-width="2"/><path d="M15 6l18 9v6" fill="none" stroke="#FFE1CF" stroke-width="2.5"/></svg>
            {%- when 'tag' -%}<svg viewBox="0 0 48 40"><path d="M8 18V6h12l18 18-14 14z" fill="#F25A0B"/><circle cx="15" cy="13" r="3" fill="#FFE1CF"/><path d="M20 25h10M22 21h6" stroke="#FFE1CF" stroke-width="2.4" stroke-linecap="round"/></svg>
            {%- else -%}<svg viewBox="0 0 48 40"><path d="M24 2 9 7v11c0 9 6.5 16 15 20 8.5-4 15-11 15-20V7z" fill="#F25A0B"/><path d="M24 2v36c8.5-4 15-11 15-20V7z" fill="#C9470A"/><path d="m16 20 6 6 10-11" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endcase -%}
          </span>
          <b>{{ block.settings.title }}</b>
          {%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}
        </div>
      {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Furneview trust band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "stat1_number", "label": "Number 1", "default": "25,000+" },
    { "type": "text", "id": "stat1_label", "label": "Label 1", "default": "Happy customers" },
    { "type": "text", "id": "stat2_number", "label": "Number 2", "default": "10,000+" },
    { "type": "text", "id": "stat2_label", "label": "Label 2", "default": "Sofa and fabric combinations" },
    { "type": "text", "id": "seal_top", "label": "Badge text", "default": "LIFETIME TERMITE", "info": "Leave empty to hide the badge." },
    { "type": "text", "id": "seal_bottom", "label": "Badge label", "default": "WARRANTY ON WOOD" },
    { "type": "text", "id": "why_heading", "label": "Heading above benefits", "default": "Why Furneview?" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "benefit", "name": "Benefit", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
      {"value":"truck","label":"Delivery"},{"value":"install","label":"Installation"},{"value":"box","label":"Returns"},{"value":"tag","label":"Price"},{"value":"shield","label":"Warranty"}]},
    { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
    { "type": "text", "id": "text", "label": "Small text (optional)", "default": "" }
  ]}],
  "presets": [{ "name": "Furneview trust band", "blocks": [
    {"type":"benefit","settings":{"icon":"truck","title":"Free shipping","text":"On all orders over ₹10,000"}},
    {"type":"benefit","settings":{"icon":"box","title":"7-day easy returns","text":"No questions asked"}},
    {"type":"benefit","settings":{"icon":"tag","title":"Best price guarantee","text":"Factory-direct pricing"}},
    {"type":"benefit","settings":{"icon":"shield","title":"Up to 5-year warranty","text":"Peace of mind, guaranteed"}}
  ]}]
}
{% endschema %}
