{%- comment -%} Renders one product media item (photo, video, YouTube/Vimeo, 3D preview) for the Furneview gallery. {%- endcomment -%}
{%- case media.media_type -%}
  {%- when 'video' -%}
    {%- if autoplay -%}
      {{ media | video_tag: controls: true, autoplay: true, muted: true, loop: true, playsinline: true, image_size: '1400x' }}
    {%- else -%}
      {{ media | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', image_size: '1400x' }}
    {%- endif -%}
  {%- when 'external_video' -%}
    {%- if autoplay -%}
      {{ media | external_video_url: autoplay: 1, mute: 1, rel: 0 | external_video_tag: allow: 'autoplay; encrypted-media; picture-in-picture', allowfullscreen: true }}
    {%- else -%}
      {{ media | external_video_url: rel: 0 | external_video_tag: loading: 'lazy', allow: 'autoplay; encrypted-media; picture-in-picture', allowfullscreen: true }}
    {%- endif -%}
  {%- else -%}
    {%- if media.preview_image -%}
      {{ media.preview_image | image_url: width: 1400 | image_tag: sizes: '(min-width: 990px) 55vw, 100vw', alt: alt, loading: loading }}
    {%- endif -%}
{%- endcase -%}
